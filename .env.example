# Database Configuration
POSTGRES_USER=portfolio_user
POSTGRES_PASSWORD=portfolio_pass
POSTGRES_DB=portfolio_db
DATABASE_URL=postgresql+asyncpg://portfolio_user:portfolio_pass@db:5432/portfolio_db

# JWT Configuration
SECRET_KEY=your-secret-key-change-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ETL Configuration
TICKER_SYMBOLS=AAPL,MSFT,GOOGL,AMZN,TSLA,META,NVDA,JPM,V,WMT,BAC,MA,HD,DIS,NFLX
ETL_ON_STARTUP=false
ETL_SCHEDULE_ENABLED=false
ETL_SCHEDULE_HOUR=0

# Demo User Credentials
DEMO_USER_EMAIL=demo@example.com
DEMO_USER_PASSWORD=demo123
